
# Real chat model (OpenAI-compatible; DeepSeek example). Leave LLM_API_KEY empty to use FakeModel.
# Worker reads these via Compose env substitution from this file / host environment.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
# Optional: force FakeModel even when LLM_API_KEY is set
# VORK_MODEL_PROVIDER=fake
# Optional request timeout (ms)
# LLM_TIMEOUT_MS=60000
